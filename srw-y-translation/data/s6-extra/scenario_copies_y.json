      "key": "296.0#1",
      "text": "「どうかな…。\n　あの二人が完全に馴染むまでは\n　まだ時間が必要だろう」"
     },
     {
      "key": "297.0#1",
      "text": "（それでもキラの背中を任せても\n　大丈夫だな…）"
     },
     {
      "key": "298.0#1",
      "text": "「なんだか…嬉しそうですね、アスランさん」"
     },
     {
      "key": "299.0#1",
      "text": "「そう見えるか？」"
     },
     {
      "key": "300.0#1",
      "text": "「はい…」"
     },
     {
      "key": "301.0#1",
      "text": "「それならいい」"
     },
     {
      "key": "301.1#1",
      "text": "「本当はキラさんとシンに嫉妬してたりして…」"
     },
     {
      "key": "301.2#1",
      "text": "「俺が…！？\n　シンに…！？」"
     },
     {
      "key": "301.3#1",
      "text": "「動揺しすぎですよ。\n　ちょっと精神修養が足りないんじゃないですか？」"
     },
     {
      "key": "304.0#1",
      "text": "「今度はアスランが\n　ＮＩＮＪＡ修行をするべきですね」"
