     {
      "key": "188.0#1",
      "text": "（うるせえ…！\n　こっちはエレガントぶるのに\n　精一杯なんだよ！）"
     },
     {
      "key": "189.0#1",
      "text": "（そんなにアニーナ先生が怖いのか！？）"
     },
     {
      "key": "190.0#1",
      "text": "（そうじゃねえ！\n　レンレンのためだ！）"
     },
     {
      "key": "191.0#1",
      "text": "（レンレンの…？）"
     },
     {
      "key": "192.0#1",
      "text": "（俺達、レンレンさんに\n　迷惑をかけっぱなしだからな）"
     },
     {
      "key": "193.0#1",
      "text": "（そのお詫びだ。\n　少しぐらいムチャだろうと\n　今日は言う通りにする）"
     },
     {
      "key": "194.0#1",
      "text": "（それが俺達なりのケジメだ）"
     },
     {
      "key": "195.0#1",
      "text": "「各機、お気を付けて！\n　別方向からもいらっしゃいます！」"
     },
     {
      "key": "196.0#1",
      "text": "「あの位置、よろしくなくてよ！」"
     },
     {
      "key": "197.0#1",
      "text": "「ああ、何という事でしょう！\n　思い出の学び舎がピンチです！」"
     },
     {
      "key": "198.0#1",
      "text": "「まずい…！\n　このままでは…！」"
     },
     {
      "key": "199.0#1",
      "text": "「やらなきゃ…\n　僕達の思い出の場所なんだ…！」"
     },
     {
      "key": "200.0#1",
      "text": "「うおおおおおおっ！」"
     },
     {
      "key": "201.0#1",
      "text": "「イズル！」"
     },
     {
      "key": "202.0#1",
      "text": "「くっ！」"
     },
     {
      "key": "203.0#1",
      "text": "「まずい！\n　また機体がボロボロに！」"
     },
     {
      "key": "204.0#1",
      "text": "「そんな事を言っている場合じゃないよ！\n　今は学園を守る事の方が大事なんだから！」"
     },
     {
      "key": "205.0#1",
      "text": "「その通りだ、イズル！」"
     },
     {
      "key": "206.0#1",
      "text": "「お前ばかりに、いい格好させるかよ！」"
     },
     {
      "key": "207.0#1",
      "text": "「みんな！」"
     },
     {
      "key": "208.0#1",
      "text": "「学園を守りたい気持ちは俺達も同じだ！」"
     },
     {
      "key": "209.0#1",
      "text": "「ついでにお前を守りたい気持ちもだ！」"
     },
     {
      "key": "210.0#1",
      "text": "「そのためならば\n　傷つく事だって恐れはしない！」"
     },
     {
      "key": "211.0#1",
      "text": "「やるぜ、みんな！\n　ここから反撃だ！」"
     },
     {
      "key": "212.0#1",
      "text": "「おう！\n　俺達の捨て身の攻撃を受けてみやがれ！」"
     },
     {
      "key": "213.0#1",
      "text": "「どんなもんだ！」"
     },
     {
      "key": "214.0#1",
      "text": "「みんな！\n　エーアデントも来てくれたよ！」"
     },
     {
      "key": "215.0#1",
      "text": "「無事ですか、皆さん！」"
     },
     {
      "key": "216.0#1",
      "text": "「結構、やられちまったがな！」"
     },
     {
      "key": "217.0#1",
      "text": "「だけど、学園は守ったぜ！」"
     },
     {
      "key": "218.0#1",
      "text": "「みんな…」"
     },
     {
      "key": "219.0#1",
      "text": "「すまねえ、レンレンさん！\n　また機体を傷つけちまった！」"
     },
     {
      "key": "220.0#1",
      "text": "「これというのも\n　あなた達がエレガントを忘れたからで…」"
     },
     {
      "key": "221.0#1",
      "text": "「いいんです、アニーナ先生…」"
     },
     {
      "key": "222.0#1",
      "text": "「レンレン…」"
     },
     {
      "key": "223.0#1",
      "text": "「みんな！\n　もうエレガントはいいから、\n　好きなように戦って！」"
     },
     {
      "key": "224.0#1",
      "text": "「いいんですか、それで？」"
     },
     {
      "key": "225.0#1",
      "text": "「その代わり、絶対に生きて帰ってくるのよ！」"
     },
     {
      "key": "226.0#1",
      "text": "「了解だ！」"
     },
     {
      "key": "227.0#1",
      "text": "「気をつけろ！\n　また増援が来るぜ！」"
     },
     {
      "key": "228.0#1",
      "text": "「まだこれだけの敵がいたのか…！」"
     },
     {
      "key": "229.0#1",
      "text": "「びびってんなよ、アサギ！」"
     },
     {
      "key": "230.0#1",
      "text": "「ヒーローは必ず勝つ！」"
     },
     {
      "key": "231.0#1",
      "text": "「悪党をボコボコにしてな！」"
     },
     {
      "key": "232.0#1",
      "text": "「来やがれ、ウルガル！\n　学園に手出しした事を後悔させてやる！」"
     },
     {
      "key": "233.0#1",
      "text": "「逃げようとしても、もう遅いからな！」"
     },
     {
      "key": "234.0#1",
      "text": "「お前達に味わわせてやるぜ、\n　ゲッターと俺達の恐ろしさをな！」"
     },
     {
      "key": "235.0#1",
      "text": "「エレガントさの欠片もない…！」"
     },
     {
      "key": "236.0#1",
      "text": "「でも、この方が\n　あの子達らしいですよ」"
     },
     {
      "key": "237.0#1",
      "text": "「ですね」"
     },
     {
      "key": "238.0#1",
      "text": "（頑張ってね、みんな）"
     },
     {
      "key": "239.0#1",
      "text": "「よし！\n　俺達の勝ちだ！」"
     },
     {
      "key": "240.0#1",
      "text": "「でも、いつも以上に\n　ダメージを受けちゃった…」"
     },
     {
      "key": "241.0#1",
      "text": "「すまねえ、レンレンさん！」"
     },
     {
      "key": "242.0#1",
      "text": "「いいよ」"
     },
     {
      "key": "243.0#1",
      "text": "「無事に帰ってくるっていう約束、\n　ちゃんと守ってくれたからね」"
     },
     {
      "key": "244.0#1",
      "text": "「レンレンさん…」"
     },
     {
      "key": "245.0#1",
      "text": "「早く帰っておいでよ。\n　整備班総出で修理をしなきゃならないから」"
     },
     {
      "key": "246.0#1",
      "text": "「お世話になります！」"
     },
     {
      "key": "247.0#1",
      "text": "「悪いが、頼むぜ！」"
     },
     {
      "key": "248.0#1",
      "text": "「まずい！\n　ダメージを受けている！」"
     },
     {
      "key": "249.0#1",
      "text": "「このままじゃレンレンさんの怒りが\n　また爆発する！」"
     },
     {
      "key": "250.0#1",
      "text": "「やるぞ、お前等！\n　エレガントに戦うんだ！」"
     },
     {
      "key": "251.0#1",
      "text": "「おう！\n　…じゃなくて、かしこまりました！」"
     },
     {
      "key": "252.0#1",
      "text": "「エレガントな動きで\n　必ずや美しい勝利をつかんでみせます！」"
     },
     {
      "key": "253.0#1",
      "text": "「覚悟なさい、ウルガル！\n　この私が相手をしてさしあげますわよ！」"
     },
     {
      "key": "254.0#1",
      "text": "「駄目だ…！\n　これじゃ悪霊将軍ハーディアスだ！」"
     },
     {
      "key": "255.0#1",
      "text": "「くそっ！\n　エレガントに戦うのは難しいぜ…\n　でございます！」"
     },
     {
      "key": "256.0#1",
      "text": "「拝啓、ウルガル様！\n　これから叩きのめすでございますよ！」"
     },
     {
      "key": "257.0#1",
      "text": "「このメチャクチャなしゃべり方の\n　どこがエレガントだ…！」"
     },
     {
      "key": "258.0#1",
      "text": "「そういうのを拓馬達に\n　要求する方がおかしいんだよ！」"
     },
     {
      "key": "259.0#1",
      "text": "「チョウのように華麗に舞い、\n　ハチのように鋭く刺す！」"
     },
     {
      "key": "260.0#1",
      "text": "「今こそ飛翔の時！\n　心が大空を求めているならば、\n　自由の翼を広げ、どこまでも高く遠く！」"
     },
     {
      "key": "261.0#1",
      "text": "「くそっ！\n　セリフが長いぜ！」"
     },
     {
      "key": "262.0#1",
      "text": "「エレガントに…！\n　エレガントに…！　エレガントに…！」"
     },
     {
      "key": "263.0#1",
      "text": "「僕は…いや、私は\n　エレガント・ヒーローになるのです！」"
     },
     {
      "key": "264.0#1",
      "text": "「優雅かつ華麗な動きで敵をかわし、\n　壮大かつ優美な攻撃を放つ…！」"
     },
     {
      "key": "265.0#1",
      "text": "「駄目だ…！\n　俺の神経と胃がもたない！」"
     },
     {
      "key": "266.0#1",
      "text": "「いらっしゃいませ、ウルガルさん。\n　お手合わせのほど、よろしくお願い致します」"
     },
     {
      "key": "267.0#1",
      "text": "「大人しくしていれば、\n　その身体に風穴を開けてさしあげますわよ！\n　動くんじゃねえぞですよ！」"
     },
     {
      "key": "268.0#1",
      "text": "「この美しき超電磁の輝きが\n　今、悪を成敗するのです！」"
     },
     {
      "key": "269.0#1",
      "text": "「豹馬…」"
     },
     {
      "key": "270.0#1",
      "text": "「エレガントんつもりやろうけど…」"
     },
     {
      "key": "271.0#1",
      "text": "「やめい、やめい！\n　聞いてるこっちの力が抜けるわ！」"
     },
     {
      "key": "272.0#1",
      "text": "「うるさい！\n　…じゃなくて、お黙りなさい！」"
     },
     {
      "key": "273.0#1",
      "text": "「だ、駄目です！\n　こんな戦い方をしていたら、\n　豹馬さんのいい所が出せません！」"
     },
     {
      "key": "274.0#1",
      "text": "「それでもやるんだよ！\n　レンレンさんのためにもな！」"
     },
     {
      "key": "275.0#1",
      "text": "「やっぱり、いつも通りのやり方が\n　しっくりくる…！」"
     },
     {
      "key": "276.0#1",
      "text": "「覚悟しやがれよ、ウルガル…！\n　エレガントを捨てた俺達は\n　さっきよりも３倍は強いぜ！」"
     },
     {
      "key": "277.0#1",
      "text": "「作り物のエレガントは封印だ！\n　俺は俺の心のままに戦う！」"
     },
     {
      "key": "278.0#1",
      "text": "「お前達も味わわせてやるぜ、\n　ゲッターの恐ろしさを\n　ゲップが出る程、たっぷりとな！」"
     },
     {
      "key": "279.0#1",
      "text": "「飛べば、飛べる！」"
     },
     {
      "key": "280.0#1",
      "text": "「やっぱり、こっちの方が飛べる！」"
     },
     {
      "key": "281.0#1",
      "text": "「ニセモノのエレガントより、\n　俺にはフレイアの言葉の方が性に合うぜ！」"
     },
     {
      "key": "282.0#1",
      "text": "「学園を守るためとはいえ、\n　かなりのダメージを受けちゃった…」"
     },
     {
      "key": "283.0#1",
      "text": "「ごめんなさい、レンレンさん…。\n　言いつけを守れなかった…」"
     },
     {
      "key": "284.0#1",
      "text": "「でも、必ず生きて帰ります！\n　待っている人の所に帰る事も\n　ヒーローの務めだから！」"
     },
     {
      "key": "285.0#1",
      "text": "「エレガントを意識しなくなったら、\n　動きがよくなった…！」"
     },
     {
      "key": "286.0#1",
      "text": "「…もしかして、俺は\n　エレガントが似合わない男なのか…」"
     },
     {
      "key": "287.0#1",
      "text": "「それはそれで胃が痛くなる…」"
     },
     {
      "key": "288.0#1",
      "text": "「エレガントにバラの花束を差し出したら、\n　ナンパの成功確率も上がるかも知れねえ…」"
     },
     {
      "key": "289.0#1",
      "text": "「だけどな…！\n　ウルガル相手にそんな事は\n　やってられねえんだよ！」"
     },
     {
      "key": "290.0#1",
      "text": "「やるぜ、みんな！\n　一気に敵を蹴散らす！」"
     },
     {
      "key": "291.0#1",
      "text": "「了解よ、豹馬！」"
     },
     {
      "key": "292.0#1",
      "text": "「やっぱり、豹馬さんは\n　そうでなくっちゃ！」"
     },
     {
      "key": "293.0#1",
      "text": "「お前にエレガントは似合わん！」"
     },
     {
      "key": "294.0#1",
      "text": "「そうや！\n　本能むき出しがお前のやり方や！」"
     },
     {
      "key": "295.0#1",
      "text": "「うるさい！\n　俺と脳波が一致するって事は\n　お前達も俺と似たようなもんって事だろうが！」"
     },
     {
      "key": "296.0#1",
      "text": "「あ！」"
     }
    ]
   }
  ],
  "scenario:cse20_1007_0100400a_sdemo.lua": [
   {
    "bundle": "aa/StandaloneWindows64/2f5af0724d7dd5583baed40295e221bb.bundle",
    "sha256": "2ac391b8f873ebbf6c61687c4c0dd98c09534451b170af04f7f312a4c01f9699",
    "patched": true,
    "units": [
     {
      "key": "0.8#1",
      "text": "（ここに来ると思い出します。\n　キラさんとシンさんの奮闘を）"
     },
     {
      "key": "0.9#1",
      "text": "（そう…。\n　あれは、今日のように\n　風が気持ちいい日でした…）"
     },
     {
      "key": "1.0#1",
      "text": "「…来いよ、ドモン」"
     },
     {
      "key": "2.0#1",
      "text": "「では、遠慮なく行くぞ！」"
     },
     {
      "key": "3.0#1",
      "text": "「じゃあ、ドモンさん…！\n　遠慮なく、胸をお借りします！」"
     },
     {
      "key": "4.0#1",
      "text": "「来い、$n！\n　お前の全力を見せてみろ！」"
     },
     {
      "key": "5.0#1",
      "text": "「すごいです…！」"
     },
     {
      "key": "6.0#1",
      "text": "「ＮＩＮＪＡとガンダムファイターの組み手、\n　レベル高すぎんだろ…」"
     },
     {
      "key": "7.0#1",
      "text": "「ドモンさん達の訓練を見たいっていうから、\n　案内してやったが…」"
     },
     {
      "key": "8.0#1",
      "text": "「あれに付き合わされてきた俺の苦労を\n　これで少しはわかっただろう」"
     },
     {
      "key": "9.1#1",
      "text": "「実際に見てないから、わかんないよ」"
     },
     {
      "key": "10.0#1",
      "text": "「というわけで、\n　シンとドモンさんの組み手が見たいなぁ」"
     },
     {
      "key": "11.0#1",
      "text": "「無茶言うなよ！」"
     },
     {
      "key": "12.0#1",
      "text": "「いいぞ、シン。\n　相手をしてやる」"
     },
     {
      "key": "13.0#1",
      "text": "「ドモンさんも、\n　そういうのは勘弁してくださいよ！」"
     },
     {
      "key": "14.0#1",
      "text": "「だいたい、もう俺は\n　ドモンさんの弟子じゃないんですから！」"
     },
     {
      "key": "15.0#1",
      "text": "「そうだ。\n　お前は俺のライバルだ」"
     },
     {
      "key": "16.0#1",
      "text": "「だから、切磋琢磨したいと願うのだが、\n　間違っているか？」"
     },
     {
      "key": "17.0#1",
      "text": "「ぐうう…」"
     },
     {
      "key": "18.0#1",
      "text": "「弟子の成長を確かめたいという\n　俺の想いを否定するのか？」"
     },
     {
      "key": "19.0#1",
      "text": "「どうやら仁義や人の情けというものを\n　もう一度叩き込む必要があるようだな」"
     },
     {
      "key": "20.0#1",
      "text": "「ぐうう…」"
     },
     {
      "key": "21.0#1",
      "text": "「覚悟を決めろ、シン。\n　俺もお前の成長ぶりが見たい」"
     },
     {
      "key": "22.0#1",
      "text": "「そうやって、アスランは\n　また上から目線で…！」"
     },
     {
      "key": "23.0#1",
      "text": "「だったら、まずアスランが\n　俺に手本を見せてくださいよ！」"
     },
     {
      "key": "24.0#1",
      "text": "「そうだな…」"
     },
     {
      "key": "25.0#1",
      "text": "「では、俺の代わりに\n　キラにやってもらおう」"
     },
     {
      "key": "26.0#1",
      "text": "「ちょっと…アスラン…」"
     },
     {
      "key": "27.0#1",
      "text": "「まさかの無茶ぶりかよ…」"
     },
     {
      "key": "28.0#1",
      "text": "「キ、キラさん…どうします？」"
     },
     {
      "key": "29.0#1",
      "text": "「ええと…」"
     },
     {
      "key": "30.0#1",
      "text": "「わたくしも見たいですわ、\n　キラの頑張る所を」"
     },
     {
      "key": "31.0#1",
      "text": "「…ラクスが、そう言うんなら…」"
     },
     {
      "key": "32.0#1",
      "text": "「キラさん対ドモンさん…！\n　夢の対決か…！」"
     },
     {
      "key": "33.0#1",
      "text": "「戦うのはちょっと…」"
     },
     {
      "key": "34.0#1",
      "text": "「ふむ…」"
     },
     {
      "key": "35.0#1",
      "text": "「では、二人には\n　ＮＩＮＪＡ修行をしてもらおう」"
     },
     {
      "key": "36.0#1",
      "text": "「こっちも無茶ぶりかよ！」"
     },
     {
      "key": "37.0#1",
      "text": "「でも、僕…ＮＩＮＪＡに興味があります」"
     },
     {
      "key": "38.0#1",
      "text": "「俺も！」"
     },
     {
      "key": "39.0#1",
      "text": "（ドモンさんと組み手するよりは\n　マシだろうから）"
     },
     {
      "key": "40.0#1",
      "text": "「そういう事なら、いいだろう」"
     },
     {
      "key": "41.0#1",
      "text": "「特戦隠密『朧』の頭領、\n　$Fが\n　直々に修行をつけてやる」"
     },
     {
      "key": "42.0#1",
      "text": "（あ…選択、間違えたかも…）"
     },
     {
      "key": "43.0#1",
      "text": "「場所を変えるぞ。\n　ついてこい、キラ、シン」"
     },
     {
      "key": "44.0#1",
      "text": "「こっちも、まさかの無茶ぶり！」"
     },
     {
      "key": "45.0#1",
      "text": "「でも、僕…ＮＩＮＪＡに興味があるよ」"
     },
     {
      "key": "46.0#1",
      "text": "「俺も！」"
     },
     {
      "key": "47.0#1",
      "text": "（ドモンさんと組み手するよりは\n　マシだろうから）"
     },
     {
      "key": "48.0#1",
      "text": "「そういう事なら…」"
     },
     {
      "key": "49.0#1",
      "text": "「では、特戦隠密『朧』の\n　$Fが\n　修行をつけてさしあげましょう！」"
     },
     {
      "key": "50.1#1",
      "text": "「フォルテさん、ノリノリですね！」"
     },
     {
      "key": "51.0#1",
      "text": "「場所を変えます！\n　ついてきてください！」"
     },
     {
      "key": "52.0#1",
      "text": "「………」"
     },
     {
      "key": "53.0#1",
      "text": "「………」"
     },
     {
      "key": "54.0#1",
      "text": "「………」"
     },
     {
      "key": "55.0#1",
      "text": "「………」"
     },
     {
      "key": "56.0#1",
      "text": "「ねえ…\n　あのお兄ちゃん達、何やってるの？」"
     },
     {
      "key": "57.0#1",
      "text": "「何やってるんでしょうね…」"
     },
     {
      "key": "58.0#1",
      "text": "「ずっとにらめっこしてるの？」"
     },
     {
      "key": "59.0#1",
      "text": "「たぶん、違うと思いますけど…」"
     },
     {
      "key": "60.0#1",
      "text": "「精神集中の訓練だろうな、あれは」"
     },
     {
      "key": "61.0#1",
      "text": "「こんな人混みの中で？」"
     },
     {
      "key": "62.0#1",
      "text": "「ここでやる事に意味がある」"
     },
     {
      "key": "63.0#1",
      "text": "「周りがうるさくても、\n　集中できるんですか？」"
     },
     {
      "key": "64.0#1",
      "text": "「周囲の音に惑わされているようでは\n　駄目だという事だ」"
     },
     {
      "key": "65.0#1",
      "text": "「ＮＩＮＪＡの修行って\n　意外と地味なんだな」"
     },
     {
      "key": "66.0#1",
      "text": "「同感…。\n　シンが派手に頑張る所を見たかったのに…」"
     },
     {
      "key": "67.0#1",
      "text": "「どうなんです、ドモンさん？」"
     },
     {
      "key": "68.0#1",
      "text": "「肉体の強化は一朝一夕にはいかない」"
     },
     {
      "key": "69.0#1",
      "text": "「だから、$nは\n　二人の精神を鍛える事にしたんだろう」"
     },
     {
      "key": "70.0#1",
      "text": "「それならば、すぐに効果があると？」"
     },
     {
      "key": "71.0#1",
      "text": "「それはシンとキラ次第だな」"
     },
     {
      "key": "72.0#1",
      "text": "「だが、きっかけをつかむ事ぐらいは\n　出来るかも知れない」"
     },
     {
      "key": "73.0#1",
      "text": "「…どうだ？」"
     },
     {
      "key": "74.0#1",
      "text": "「どう…って言われても…」"
     },
     {
      "key": "75.0#1",
      "text": "「やっぱり、周囲の声が耳に入っちゃって…」"
     },
     {
      "key": "76.0#1",
      "text": "「まだまだだな」"
     },
     {
      "key": "77.0#1",
      "text": "「精神集中の修行だってのは\n　何となくわかるけど、こんなやり方で\n　効果あるのか…」"
     },
     {
      "key": "78.0#1",
      "text": "「これは自分自身を\n　コントロールするための訓練だ」"
     },
     {
      "key": "79.0#1",
      "text": "「自分自身を…？」"
     },
     {
      "key": "80.0#1",
      "text": "「そうだ。\n　意外に人間ってのは\n　自分ってのを制御できてない」"
     },
     {
      "key": "81.0#1",
      "text": "「内と外、自分とその他…。\n　まずはそれをきちんと分ける事が\n　自分を制御する第一歩目だ」"
     },
     {
      "key": "82.0#1",
      "text": "「それがＮＩＮＪＡのやり方…」"
     },
     {
      "key": "83.0#1",
      "text": "「最終的には周囲の声を聞きつつ、\n　精神と肉体を完全にコントロールできるように\n　なってもらう」"
     },
     {
      "key": "84.0#1",
      "text": "「自分の世界に入り込めて、やっと半人前…\n　だが、自分の世界に閉じこもり、\n　外界をシャットアウトしては半人前のまま…」"
     },
     {
      "key": "85.0#1",
      "text": "「外に対してオープンになりながら、\n　自分自身を完全に制御するんだ」"
     },
     {
      "key": "86.0#1",
      "text": "「難しいですね…」"
     },
     {
      "key": "87.0#1",
      "text": "「そう言う$nさんは\n　出来るんですか？」"
     },
     {
      "key": "88.0#1",
      "text": "「まあな」"
     },
     {
      "key": "89.0#1",
      "text": "「今、ここで俺達がこうして話している間に\n　スレッタとチュチュは\n　今日の晩ご飯のメニューの話をしている」"
     },
     {
      "key": "90.0#1",
      "text": "「え…！」"
     },
     {
      "key": "91.0#1",
      "text": "「アスランは見学に飽きてきたらしく、\n　理由をつけて抜け出す事を考えている」"
     },
     {
      "key": "92.0#1",
      "text": "「アスラン！\n　人には修行させておいて！」"
     },
     {
      "key": "93.0#1",
      "text": "「ご、誤解だ、シン…！\n　俺はそんな事は…」"
     },
     {
      "key": "94.0#1",
      "text": "「誤魔化し方が下手だね、アスランは」"
     },
     {
      "key": "95.0#1",
      "text": "「ってな感じで\n　極めれば、これくらい感覚を鋭敏にする事も\n　出来るようになる」"
     },
     {
      "key": "96.0#1",
      "text": "「…わかりました。\n　もっと努力します」"
     },
     {
      "key": "97.0#1",
      "text": "「………」"
     },
     {
      "key": "98.0#1",
      "text": "「どうしたの、シン？」"
     },
     {
      "key": "99.0#1",
      "text": "「あ…いえ…」"
     },
     {
      "key": "100.0#1",
      "text": "「その…キラさんにも\n　出来ない事があるんだな…って…」"
     },
     {
      "key": "101.0#1",
      "text": "「え…」"
     },
     {
      "key": "102.0#1",
      "text": "「俺…キラさんは万能で\n　出来ない事なんてないと思ってました…」"
     },
     {
      "key": "103.0#1",
      "text": "「ふふ…」"
     },
     {
      "key": "104.0#1",
      "text": "「俺…おかしなこと言いました？」"
     },
     {
      "key": "105.0#1",
      "text": "「ごめんなさい。\n　でも、ちょっと面白くて」"
     },
     {
      "key": "106.0#1",
      "text": "「確かにキラはすごい奴だけど、\n　すごくない所もたくさんある」"
     },
     {
      "key": "107.0#1",
      "text": "「近くにいると\n　すぐにわかりますよ」"
     },
     {
      "key": "108.0#1",
      "text": "「そうなんですか…」"
     },
     {
      "key": "109.0#1",
      "text": "「みんなの言う通りだよ。\n　僕は苦手な事がたくさんあるんだ」"
     },
     {
      "key": "110.0#1",
      "text": "「でも、苦手だからって\n　それを言い訳にして\n　逃げたくないって思ってる」"
     },
     {
      "key": "111.0#1",
      "text": "「キラさん…」"
     },
     {
      "key": "112.0#1",
      "text": "「いいぞ。\n　そういう風に自分を成長させようとする気持ちが\n　大事だ」"
     },
     {
      "key": "113.0#1",
      "text": "「気持ちだけで出来るようになれば、\n　苦労はないですよ」"
     },
     {
      "key": "114.0#1",
      "text": "「そう言うな。\n　全ては精神の在り方だ」"
     },
     {
      "key": "115.0#1",
      "text": "「例えば、成長したいのならば、\n　それを心の中でイメージする事で\n　より直接的な作用が生まれる事もある」"
     },
     {
      "key": "116.0#1",
      "text": "「もうちょっと具体的に\n　教えてもらえませんか？」"
     },
     {
      "key": "117.0#1",
      "text": "「そうだな…」"
     },
     {
      "key": "118.0#1",
      "text": "「では、種をイメージしろ」"
     },
     {
      "key": "119.0#1",
      "text": "「種…？」"
     },
     {
      "key": "120.0#1",
      "text": "「種は可能性の象徴…。\n　自分の事を芽吹く前の種だと\n　イメージするんだ」"
     },
     {
      "key": "121.0#1",
      "text": "「それがはじけて、そこから生まれるもの…\n　それこそが、なりたい自分の姿だ」"
     },
     {
      "key": "122.0#1",
      "text": "「なりたい自分…」"
     },
     {
      "key": "123.0#1",
      "text": "「そう…。\n　種に成長のイメージを乗せて、\n　精神と肉体をそれに同調させるんだ」"
     },
     {
      "key": "124.0#1",
      "text": "「やってみます…」"
     },
     {
      "key": "125.0#1",
      "text": "「俺も…！」"
     },
